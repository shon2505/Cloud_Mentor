# ========================================================
# CloudMentor - Environment Variables
# ========================================================

# Required: Your Groq API Key
# Sign up and generate an API key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq API Base URL
GROQ_BASE=https://api.groq.com/openai/v1/chat/completions

# Model to use in project (Default: openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-20b
